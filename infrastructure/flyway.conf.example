# Copy this file to flyway.conf in this folder and fill in your local database details.
# Run Flyway from this folder (infrastructure/), e.g. "flyway migrate".
# NOTE: DO NOT COMMIT THE DATABASE DETAILS. flyway.conf is in .gitignore.

flyway.url=jdbc:postgresql://localhost:5432/<local-db-name>
flyway.user=<local-db-user>
flyway.locations=filesystem:migrations
flyway.password=<local-db-password>
